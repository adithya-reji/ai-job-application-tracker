PROJECT_NAME=ai-job-application-tracker

# Database Credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_database_password_here
POSTGRES_DB=jat_db
DB_PORT=5433

# Database Connection String
# Replace 'your_database_password_here' with the password you set above
DATABASE_URL=postgresql+psycopg://postgres:your_database_password_here@localhost:5433/jat_db

# Security
# You can generate a secure key by running: openssl rand -hex 32
SECRET_KEY=your_jwt_secret_key_here

# AI Integration
GEMINI_API_KEY=your_gemini_api_key_here